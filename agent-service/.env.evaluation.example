# Evaluation-only overrides.
#
# Copy this file to `.env.evaluation` and load it in addition to the normal
# `.env`. Keep real secrets and service URLs in `.env`; this file only changes
# behavior that is intentionally different during the live baseline.

AGENT_ENVIRONMENT=evaluation
AGENT_CHAT_RATE_LIMIT_REQUESTS=50
AGENT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
