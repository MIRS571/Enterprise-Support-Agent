AGENT_ENVIRONMENT=local
AGENT_APP_NAME=Enterprise Support Agent
AGENT_BUSINESS_SERVICE_BASE_URL=http://127.0.0.1:8080
AGENT_BUSINESS_SERVICE_TIMEOUT_SECONDS=5
AGENT_BUSINESS_SERVICE_MAX_RETRIES=2
# AGENT_INTERNAL_SERVICE_TOKEN=generate-at-least-32-random-characters
AGENT_LLM_MODEL=deepseek-v4-flash
AGENT_LLM_API_KEY=replace-with-your-api-key
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_THINKING_ENABLED=false

AGENT_CHECKPOINT_ENABLED=false
# AGENT_CHECKPOINT_DATABASE_URL=postgresql://agent_checkpoint:replace-with-password@127.0.0.1:5432/agent_checkpoint

AGENT_REDIS_ENABLED=false
# AGENT_REDIS_URL=redis://:replace-with-password@127.0.0.1:6379/0
AGENT_REDIS_SOCKET_TIMEOUT_SECONDS=1
AGENT_REDIS_KEY_PREFIX=esa
AGENT_ORDER_CACHE_TTL_SECONDS=15
AGENT_CHAT_RATE_LIMIT_REQUESTS=10
AGENT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

AGENT_QDRANT_URL=http://127.0.0.1:6333
# AGENT_QDRANT_API_KEY=replace-with-your-qdrant-api-key
AGENT_QDRANT_COLLECTION_NAME=enterprise_support_knowledge_hybrid_v1
AGENT_KNOWLEDGE_BASE_DIRECTORY=data/knowledge
AGENT_RAG_ENABLED=true

AGENT_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AGENT_EMBEDDING_DEVICE=cpu
AGENT_EMBEDDING_NORMALIZE=true
AGENT_SPARSE_EMBEDDING_MODEL_NAME=Qdrant/bm25

AGENT_RAG_TOP_K=3
AGENT_RAG_CANDIDATE_K=10
AGENT_RAG_RERANKER_ENABLED=true
AGENT_RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# Optional offline model directory containing onnx/model.onnx and tokenizer files.
# AGENT_RAG_RERANKER_MODEL_PATH=../../.model-cache/bge-reranker-base
AGENT_RAG_RERANKER_BATCH_SIZE=8
AGENT_RAG_CHUNK_SIZE=500
AGENT_RAG_CHUNK_OVERLAP=80
